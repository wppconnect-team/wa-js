{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": false,
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "removeComments": false,
    "resolveJsonModule": true,
    "rootDir": "./src",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2017",
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["src/tools/**/*"]
}
